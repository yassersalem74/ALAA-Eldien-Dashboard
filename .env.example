# Backend origin only, without /api/v1. Never put a bearer token in a VITE_ variable.
VITE_API_BASE_URL=https://alaaeldin.runasp.net

# Supply the actual admin endpoints from Swagger; /users/me is not a directory.
VITE_USERS_LIST_PATH=
# Must contain {id}. Leave blank until the admin delete endpoint is confirmed.
VITE_USER_DELETE_PATH=

# Enable only if your backend authenticates using cookies (requires credentialed CORS).
VITE_API_USE_COOKIES=false
